# .env.example — Template for production Docker deployment
# Copy to .env and fill in real values
# NEVER commit .env to git

# ─── FRONTEND (Next.js) ──────────────────────────────────────────────────────

# Public URL of the website (canonical URLs, OG tags, sitemap)
NEXT_PUBLIC_BASE_URL=https://site.mesrit.com

# Internal Docker URL for the /api/strapi/* proxy route
# Docker: http://backend:1337  |  Local dev: http://localhost:1337
NEXT_PUBLIC_STRAPI_API_URL=http://backend:1337

# Strapi API token with read-only access (generate in Strapi admin → API Tokens)
STRAPI_API_TOKEN=

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA_ID=

# GlitchTip / Sentry error monitoring (optional)
NEXT_PUBLIC_GLITCHTIP_DSN=
GLITCHTIP_DSN=

# ─── CHATBOT IA ──────────────────────────────────────────────────────────────

# Provider par défaut utilisé par Chatbot.js : 'groq' (gratuit), 'claude' ou 'openai'

# Groq — GRATUIT, clé sur https://console.groq.com/keys (requis si provider='groq', défaut)
GROQ_API_KEY=

# Anthropic Claude — payant (requis si provider='claude', optionnel)
ANTHROPIC_API_KEY=

# OpenAI GPT — payant (requis si provider='openai', optionnel)
OPENAI_API_KEY=

# ─── STRIPE (paiements) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── SMTP (emails via Brevo) ─────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mesrit.ne

# ─── BACKEND — see ./backend/.env.example for Strapi-specific variables ──────
