# ========================================
# ENVIRONNEMENT
# ========================================
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://site.mesrit.com

# ========================================
# BASE DE DONNÉES
# ========================================
# MongoDB Local
MONGODB_URI=mongodb://username:password@localhost:27017/mesrit_db

# OU MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/mesrit_db?retryWrites=true&w=majority

# ========================================
# SÉCURITÉ
# ========================================
# Générer avec: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-32-characters
NEXTAUTH_SECRET=your-nextauth-secret-32-characters
API_KEY=your-api-key-32-characters
SESSION_SECRET=your-session-secret-32-characters

# ========================================
# CLOUDFLARE TURNSTILE (Captcha)
# ========================================
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=your-cloudflare-site-key
CLOUDFLARE_SECRET_KEY=your-cloudflare-secret-key

# ========================================
# EMAIL (SendGrid)
# ========================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@mesrit.com
EMAIL_ADMIN=admin@mesrit.com

# ========================================
# REDIS (Cache/Sessions) - Optionnel
# ========================================
REDIS_URL=redis://localhost:6379
# OU Redis Cloud
# REDIS_URL=redis://default:password@redis-xxxxx.cloud.redislabs.com:12345

# ========================================
# ALLOWED ORIGINS (CORS)
# ========================================
ALLOWED_ORIGINS=https://site.mesrit.com,https://www.site.mesrit.com

# ========================================
# CHATBOT IA (Choisir l'un des deux)
# ========================================
# OpenAI (GPT-3.5-turbo, GPT-4)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OU Anthropic Claude (Haiku, Sonnet)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ========================================
# LOGS
# ========================================
LOG_LEVEL=info
