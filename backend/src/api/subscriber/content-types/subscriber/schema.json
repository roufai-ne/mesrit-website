{
  "kind": "collectionType",
  "collectionName": "subscribers",
  "info": {
    "singularName": "subscriber",
    "pluralName": "subscribers",
    "displayName": "Newsletter Subscriber",
    "description": "Abonnés à la newsletter"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "active",
        "unsubscribed"
      ],
      "default": "pending"
    },
    "subscribedAt": {
      "type": "datetime",
      "default": null
    },
    "confirmationToken": {
      "type": "string"
    },
    "unsubscribeToken": {
      "type": "string"
    },
    "confirmationTokenExpires": {
      "type": "datetime"
    },
    "unsubscribeTokenExpires": {
      "type": "datetime"
    }
  }
}